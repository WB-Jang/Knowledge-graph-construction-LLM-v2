# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter

# ── OpenRouter (primary provider) ─────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pipeline v2 role-specific models
FORMATTER_MODEL=mistralai/mistral-nemo
GENERATOR_MODEL=google/gemma-4-26b-a4b-it
EVALUATOR_MODEL=deepseek/deepseek-v4-flash

# Legacy single-model fallback (used by get_llm("openrouter"))
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── LLM Inference Parameters ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Google Gemini (optional alternative) ──────────────────────────────────────
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-preview-09-2025

# ── Groq (optional alternative) ───────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Memgraph ──────────────────────────────────────────────────────────────────
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ── Pipeline Settings ─────────────────────────────────────────────────────────
PIPELINE_VERSION=2.0
# Max retries before an article is sent to the dead letter queue
MAX_RETRIES=3
# Evaluator pass threshold (0.0–1.0)
EVAL_PASS_THRESHOLD=0.7
