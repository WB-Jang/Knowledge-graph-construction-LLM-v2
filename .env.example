# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter

# ── OpenRouter (primary provider) ─────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pipeline v2 role-specific models
FORMATTER_MODEL=mistralai/mistral-nemo
GENERATOR_MODEL=google/gemma-4-26b-a4b-it
EVALUATOR_MODEL=deepseek/deepseek-v4-flash

# Legacy single-model fallback (used by get_llm("openrouter"))
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── LLM Inference Parameters ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
# 추출/평가 LLM 출력 토큰 한도 (기본 4096)
LLM_MAX_TOKENS=4096

# ── Formatter (Markdown 정규화) 설정 ──────────────────────────────────────────
# Formatter는 입력을 (거의) 그대로 Markdown으로 되돌려주므로 출력 토큰 한도가 커야 함
FORMATTER_MAX_TOKENS=16000
# 긴 문서는 청크 단위로 나눠 포맷팅 (청크당 최대 입력 문자 수)
FORMATTER_CHUNK_SIZE=8000
# true로 켜면 각 청크의 LLM 원본 출력 미리보기를 로그로 출력 (디버깅용)
FORMATTER_DEBUG=false

# ── Google Gemini (optional alternative) ──────────────────────────────────────
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-preview-09-2025

# ── Groq (optional alternative) ───────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Memgraph ──────────────────────────────────────────────────────────────────
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ── Pipeline Settings ─────────────────────────────────────────────────────────
PIPELINE_VERSION=2.0
# Max retries before an article is sent to the dead letter queue
MAX_RETRIES=3
# Evaluator pass threshold (0.0–1.0)
EVAL_PASS_THRESHOLD=0.7

# ── (옵션) 의미 유사도 기반 동적 글로벌 컨텍스트 ───────────────────────────────
# 기본 비활성화. true로 켜면 현재 조항과 의미적으로 유사한 다른 조항을 동적으로
# 선택하여 관계 추출 시 글로벌 컨텍스트(앵커 조항)로 함께 주입합니다.
ENABLE_SEMANTIC_GLOBAL_CONTEXT=false
# 유사도 방식: "lexical"(기본, 추가 의존성 없음) | "embedding"(langchain-openai 필요)
SEMANTIC_SIMILARITY_METHOD=lexical
# 동적으로 주입할 유사 조항 개수 / 최소 유사도 점수
SEMANTIC_TOP_K=3
SEMANTIC_MIN_SCORE=0.0
# embedding 방식 사용 시 설정 (미설정 시 OpenAI 기본값/OPENAI_API_KEY 사용)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
